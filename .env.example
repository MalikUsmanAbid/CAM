# The mock provider is the safe default and needs no credentials.
AI_PROVIDER=mock
AI_MODEL=jarvis-dev
# Optional live local chat/coding adapter; start a configured Ollama server separately.
# AI_PROVIDER=ollama
# AI_ENDPOINT=http://127.0.0.1:11434
# AI_MODEL=qwen2.5-coder:1.5b
# No API key is needed for Ollama. Mock does not execute a live model.
# Optional live cloud chat provider.
# AI_PROVIDER=openai_compatible
# AI_ENDPOINT=https://provider.example/v1
# AI_API_KEY_REF=env:JARVIS_PROVIDER_API_KEY
AI_TIMEOUT_SECONDS=15
# One total request deadline shared by live chat and live task planning.
AI_MAX_OUTPUT_TOKENS=1024
# Task planning uses an independent explicit provider selection.
BRAIN_PROVIDER=mock
BRAIN_MODEL=jarvis-dev
# Reuse the chat credential only by explicitly setting this reference to the same variable.
# BRAIN_ENDPOINT=https://provider.example/v1
# BRAIN_API_KEY_REF=env:JARVIS_PROVIDER_API_KEY
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Default persistence is outside the repository: %LOCALAPPDATA%/USMANJARVIS.
# An explicit database path must be local, not a cloud-synced/network directory.
# DATABASE_PATH=C:/local-jarvis-data/jarvis.db
# JARVIS_DATA_DIR=C:/portable-jarvis/data
SAFE_WORKSPACE=./workspace
